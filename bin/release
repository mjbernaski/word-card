#!/bin/bash
# Archive and distribute every platform a scheme supports, in one command.
#
# Xcode's Archive action only ever archives the platform of the currently
# selected run destination, so shipping a multiplatform target means repeating
# the whole flow by hand once per platform. Missing one is silent: ImageCard's
# macOS build carried the CloudKit container fix while the iOS build did not,
# and for weeks the two apps mirrored into different iCloud containers without
# either of them reporting an error.

set -euo pipefail

PROJECT="WordCard.xcodeproj"
OUT_DIR="build/release"
TEAM_ID="DQPDVF6ZSY"

usage() {
    cat <<EOF
release - archive a scheme for every platform it ships on

Usage:
  release <scheme> [platform ...]   Archive, then export for App Store Connect
  release --archive-only <scheme> [platform ...]

Schemes: WordCard, ImageCard
Platforms default to "iOS macOS"; pass them explicitly to override
(e.g. "release WordCard iOS macOS visionOS").

Archives land in $OUT_DIR/<scheme>-<platform>.xcarchive and exports beside
them. Build numbers come from the project: the generated export options set
manageAppVersionAndBuildNumber=false, so bump CURRENT_PROJECT_VERSION before
running or App Store Connect will reject the build as a duplicate. The build
and marketing version are echoed before each archive so you can catch a
forgotten bump before waiting on a Release build.

Uploading needs an App Store Connect API key. Set these first:

  export ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
  export ASC_KEY_ID=XXXXXXXXXX
  export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

Without them, only --archive-only works and you distribute from Xcode's
Organizer by hand.

Signing is manual on purpose. Xcode.app signs with a *cloud-managed*
distribution certificate, which API keys cannot access — xcodebuild then fails
with "Cloud signing permission error" no matter what -allowProvisioningUpdates
is told to do. The way through is real local certificates plus explicit
profiles. Create these once in Xcode > Settings > Accounts > Manage
Certificates (+):

  Apple Distribution              signs the app (both platforms)
  Mac Installer Distribution      signs the .pkg (macOS App Store only)

Mac uploads need installerSigningCertificate as well as signingCertificate:
the profile covers the app, not the installer.

Every bundle inside the archive needs its own App Store profile, named exactly
as listed in signing_config() below — an embedded extension with no profile
fails the export even though the app itself is signed. WordCard embeds
WordCardWidget on iOS, macOS, and visionOS (but not tvOS, which the widget
target does not support), so those platforms need two profiles each.
Run "release --profiles <scheme> [platform ...]" to print the exact list.
EOF
}

# Per-scheme, per-platform App Store signing configuration.
#
# Each line is "<bundle-id>|<profile-name>", one per bundle the archive
# contains. This is the whole reason the script exists as a table rather than a
# pair of variables: the previous version hardcoded ImageCard's bundle ID and
# profiles, so pointing it at WordCard archived the right app and then handed
# the exporter a profile map that did not mention WordCard at all.
signing_config() {
    local scheme="$1" platform="$2"

    case "$scheme:$platform" in
        WordCard:iOS)
            echo "mjbernaski.wordcard.app|WordCard iOS App Store"
            echo "mjbernaski.wordcard.app.WordCardWidget|WordCard Widget iOS App Store"
            ;;
        WordCard:macOS)
            echo "mjbernaski.wordcard.app|WordCard macOS App Store"
            echo "mjbernaski.wordcard.app.WordCardWidget|WordCard Widget macOS App Store"
            ;;
        WordCard:visionOS)
            echo "mjbernaski.wordcard.app|WordCard visionOS App Store"
            echo "mjbernaski.wordcard.app.WordCardWidget|WordCard Widget visionOS App Store"
            ;;
        WordCard:tvOS)
            # WordCardWidget does not support appletvos, so the tvOS archive
            # embeds no extension and needs no second profile.
            echo "mjbernaski.wordcard.app|WordCard tvOS App Store"
            ;;
        ImageCard:iOS)
            echo "mjbernaski.imagecard.app|ImageCard iOS App Store"
            ;;
        ImageCard:macOS)
            echo "mjbernaski.imagecard.app|ImageCard macOS App Store"
            ;;
    esac
}

require_signing_config() {
    local scheme="$1" platform="$2"
    if [[ -z "$(signing_config "$scheme" "$platform")" ]]; then
        echo "release: no App Store profiles configured for $scheme on $platform." >&2
        echo "         Add an entry to signing_config() in $0." >&2
        exit 1
    fi
}

write_export_options() {
    local scheme="$1" platform="$2" out="$3"

    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        echo '<plist version="1.0"><dict>'
        echo "  <key>destination</key><string>upload</string>"
        echo "  <key>method</key><string>app-store-connect</string>"
        echo "  <key>manageAppVersionAndBuildNumber</key><false/>"
        echo "  <key>signingStyle</key><string>manual</string>"
        echo "  <key>signingCertificate</key><string>Apple Distribution</string>"
        # The .pkg an App Store macOS upload ships in is signed by a different
        # certificate than the app inside it, and the profile does not cover it.
        [[ "$platform" == "macOS" ]] && \
            echo "  <key>installerSigningCertificate</key><string>3rd Party Mac Developer Installer</string>"
        echo "  <key>provisioningProfiles</key><dict>"
        while IFS='|' read -r bundle profile; do
            [[ -z "$bundle" ]] && continue
            echo "    <key>${bundle}</key><string>${profile}</string>"
        done < <(signing_config "$scheme" "$platform")
        echo "  </dict>"
        echo "  <key>stripSwiftSymbols</key><true/>"
        echo "  <key>teamID</key><string>${TEAM_ID}</string>"
        echo "  <key>uploadSymbols</key><true/>"
        echo '</dict></plist>'
    } > "$out"
}

print_versions() {
    local scheme="$1" platform="$2"
    # Purely informational, and running under `set -e -o pipefail`: never let a
    # failed lookup take the release down with it.
    xcodebuild -project "$PROJECT" -scheme "$scheme" -configuration Release \
        -destination "generic/platform=${platform}" -showBuildSettings 2>/dev/null \
        | awk '/ MARKETING_VERSION = / {m=$3} / CURRENT_PROJECT_VERSION = / {b=$3}
               END {if (m != "" || b != "") printf "    version %s (build %s)\n", m, b}' \
        || true
}

archive_only=false
print_profiles=false
case "${1:-}" in
    --archive-only) archive_only=true; shift ;;
    --profiles)     print_profiles=true; shift ;;
esac

scheme="${1:-}"
if [[ -z "$scheme" || "$scheme" == "-h" || "$scheme" == "--help" ]]; then
    usage
    [[ -z "$scheme" ]] && exit 2 || exit 0
fi
shift

platforms=("$@")
[[ ${#platforms[@]} -eq 0 ]] && platforms=(iOS macOS)

# Validate every platform before archiving anything. A missing profile used to
# surface only at export, after a full Release build had already run.
for platform in "${platforms[@]}"; do
    require_signing_config "$scheme" "$platform"
done

if [[ "$print_profiles" == true ]]; then
    echo "App Store profiles required for $scheme:"
    for platform in "${platforms[@]}"; do
        echo "  $platform"
        while IFS='|' read -r bundle profile; do
            [[ -z "$bundle" ]] && continue
            printf '    %-45s %s\n' "$bundle" "$profile"
        done < <(signing_config "$scheme" "$platform")
    done
    exit 0
fi

mkdir -p "$OUT_DIR"

for platform in "${platforms[@]}"; do
    archive="$OUT_DIR/${scheme}-${platform}.xcarchive"
    echo "==> Archiving $scheme for $platform"
    print_versions "$scheme" "$platform"
    xcodebuild archive \
        -project "$PROJECT" \
        -scheme "$scheme" \
        -configuration Release \
        -destination "generic/platform=${platform}" \
        -archivePath "$archive" \
        -allowProvisioningUpdates

    if [[ "$archive_only" == true ]]; then
        echo "==> Archived: $archive"
        continue
    fi

    if [[ -z "${ASC_KEY_PATH:-}" || -z "${ASC_KEY_ID:-}" || -z "${ASC_ISSUER_ID:-}" ]]; then
        echo "==> Archived: $archive"
        echo "    Skipping upload: ASC_KEY_PATH / ASC_KEY_ID / ASC_ISSUER_ID not set." >&2
        continue
    fi

    opts="$OUT_DIR/exportOptions-${scheme}-${platform}.plist"
    write_export_options "$scheme" "$platform" "$opts"

    echo "==> Uploading $scheme ($platform) to App Store Connect"
    xcodebuild -exportArchive \
        -archivePath "$archive" \
        -exportPath "$OUT_DIR/${scheme}-${platform}-upload" \
        -exportOptionsPlist "$opts" \
        -authenticationKeyPath "$ASC_KEY_PATH" \
        -authenticationKeyID "$ASC_KEY_ID" \
        -authenticationKeyIssuerID "$ASC_ISSUER_ID"
done

echo "==> Done: ${platforms[*]}"
